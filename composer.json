{
  "name": "scalexy/filament-bulk-upload",
  "description": "Direct S3 bulk upload field for Filament and Spatie Media Library",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "filament/forms": "^4.0 || ^5.0",
    "spatie/laravel-medialibrary": "^11.0",
    "league/flysystem-aws-s3-v3": "^3.0",
    "illuminate/support": "^12.0 || ^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.0 || ^12.0",
    "laravel/pint": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "ScaleXY\\FilamentBulkUpload\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ScaleXY\\FilamentBulkUpload\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ScaleXY\\FilamentBulkUpload\\BulkUploadServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "format": "pint"
  },
  "config": {
    "sort-packages": true
  }
}
